{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reli:schema:v1:metric_profile",
  "title": "MetricProfileV1",
  "type": "object",
  "required": [
    "profile_id",
    "vertical",
    "schema_version",
    "supported_algorithms",
    "max_latency_ms",
    "min_quality_score"
  ],
  "properties": {
    "profile_id": { "type": "string", "minLength": 1 },
    "vertical": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 5 },
    "supported_algorithms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "max_latency_ms": { "type": "integer", "minimum": 0 },
    "min_quality_score": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}
